# These values are stored as Cloudflare Secrets (SUPABASE_URL, SUPABASE_ANON_KEY)
# and injected into the build as the VITE_ prefixed vars below. Never commit a
# real .env file — see README.md "Secrets management" for setup instructions.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
